# 网关环境变量样例。真实值只放在服务器（/etc/ds-gateway.env），不进仓库。
PORT=8787
HOST=127.0.0.1

# 客户端要出示的网关令牌（真实值请用 openssl rand -hex 32 生成）
GATEWAY_TOKEN=<your-gateway-token>

# 真正的 DeepSeek Key（只在服务端，永远不下发到客户端）
DEEPSEEK_API_KEY=<your-deepseek-key>
DEEPSEEK_ORIGIN=https://api.deepseek.com

# 记忆库
MEMORY_DB_PATH=/var/lib/ds-gateway/memory.db
CONTEXT_BUDGET_TOKENS=300000

# 记忆召回硬预算（毫秒）。召回卡在"收到请求"和"转发上游"之间，
# 每一毫秒都直接加在首字延迟上；超预算就这一轮不注入。0 = 不限制。
# MEMORY_RECALL_BUDGET_MS=400
# MEMORY_RERANK_TIMEOUT_MS=900

# 语义召回（可选；不配则退回纯词法检索）
# MEMORY_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# MEMORY_EMBED_API_KEY=<your-embedding-key>
# MEMORY_EMBED_MODEL=BAAI/bge-m3
# MEMORY_EMBED_DIM=1024
# MEMORY_EMBED_DELAY_MS=80
